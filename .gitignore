*.mp3
# Audio that ships with a release, seeded into the device's own audio/ folder by
# apply_settings.sh. Everything under audio/ stays ignored - that is the owner's.
!**/default-audio/**/*.mp3
dist/
__pycache__/
*.pyc
tools/manual_pdf/.venv/

# A device owner's own copy of the user manual, with a QR code for their device -
# tools/build_manual_pdf.sh --device. Handed to them, never committed.
DR_LOUAY_USER_MANUAL_AR.pdf
