#!/bin/sh
# Installed to /etc/NetworkManager/dispatcher.d by scheduler-apply-system (system_apply.sh).
# The Wi-Fi chip can go deaf to inbound traffic while staying associated, with nothing
# logged; promiscuous mode hands every frame to the kernel and has kept the Pi 4s
# reachable since. NetworkManager drops the flag on every reconnect, so it is set again
# each time the link comes up.
[ "$1" = "wlan0" ] || exit 0
case "$2" in
    up|dhcp4-change|reapply) /usr/sbin/ip link set wlan0 promisc on ;;
esac
