[Unit]
Description=Prayer Scheduler Website (LAN)
After=network.target

[Service]
User=ihms
WorkingDirectory=/home/ihms/Desktop/scheduler
ExecStart=/usr/bin/python3 /home/ihms/Desktop/scheduler/applications/services/web_ui/main.py
Restart=always
RestartSec=5
# Port 80, so the address is plain http://<hostname>.local with nothing to remember.
# This grants the one capability that needs, and nothing else - the process still runs as
# the device user, not as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# XDG_RUNTIME_DIR is deliberately NOT set here. It was, as /run/user/%U, and on a real
# device %U resolved to 0 even with User= set above - so the service looked for PipeWire
# and for the session bus under root's runtime directory, found neither, and every mute
# fell back to killing the player. applications/shared/mute.py derives it from the
# running process's own uid instead, which cannot be wrong, and sets the session bus
# address with it.
StandardOutput=append:/home/ihms/Desktop/scheduler/logs/web_ui.log
StandardError=append:/home/ihms/Desktop/scheduler/logs/web_ui.log

[Install]
WantedBy=multi-user.target
